{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Monitoring": {
    "Target": {
      "Id": "example",
      "Name": "Example service",
      "Url": "https://example.com/",
      "Enabled": false,
      "ExpectedStatusCode": 200,
      "TimeoutSeconds": 10
    }
  }
}
